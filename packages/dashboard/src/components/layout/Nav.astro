---
interface Props {
  current: 'home' | 'traffic' | 'workers' | 'ai' | 'billing' | 'apps';
}
const { current } = Astro.props;

const items = [
  { id: 'home', href: '/', label: 'Home' },
  { id: 'traffic', href: '/traffic', label: 'Traffic' },
  { id: 'workers', href: '/workers', label: 'Workers' },
  { id: 'apps', href: '/apps', label: 'Apps' },
  { id: 'ai', href: '/ai', label: 'AI' },
  { id: 'billing', href: '/billing', label: 'Billing' },
] as const;
---

<nav class="nav">
  {
    items.map((item) => (
      <a
        href={item.href}
        class="nav-item"
        aria-current={current === item.id ? 'page' : undefined}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          {item.id === 'home' && (
            <path d="M3 11l9-8 9 8v9a2 2 0 0 1-2 2h-4v-7h-6v7H5a2 2 0 0 1-2-2z" />
          )}
          {item.id === 'traffic' && (
            <path d="M3 12h4l3-9 4 18 3-9h4" />
          )}
          {item.id === 'workers' && (
            <path d="M13 2L3 14h9l-1 8 10-12h-9z" />
          )}
          {item.id === 'apps' && (
            <>
              <rect x="3" y="3" width="7" height="7" rx="1" />
              <rect x="14" y="3" width="7" height="7" rx="1" />
              <rect x="3" y="14" width="7" height="7" rx="1" />
              <rect x="14" y="14" width="7" height="7" rx="1" />
            </>
          )}
          {item.id === 'ai' && (
            <>
              <rect x="4" y="5" width="16" height="14" rx="2" />
              <circle cx="9" cy="12" r="1" />
              <circle cx="15" cy="12" r="1" />
            </>
          )}
          {item.id === 'billing' && (
            <>
              <rect x="2" y="6" width="20" height="12" rx="2" />
              <path d="M2 10h20" />
            </>
          )}
        </svg>
        <span>{item.label}</span>
      </a>
    ))
  }
</nav>
