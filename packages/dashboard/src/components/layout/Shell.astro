---
import Nav from './Nav.astro';
import { CONFIG } from '../../config';
import '../../styles/global.css';

interface Props {
  title: string;
  current: 'home' | 'traffic' | 'workers' | 'ai' | 'billing' | 'apps';
}
const { title, current } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="flarestat" />
    <link rel="manifest" href="/manifest.json" />
    {/* Favicon inlined as a data URL because Cloudflare Access gates all
        subresource fetches on this hostname, which blocks browser tab
        favicon requests. The inline version renders from the HTML the
        browser already has. */}
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="data:image/png;base64,"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <title>{title} · {CONFIG.brandName}</title>
  </head>
  <body>
    <main class="page">
      <slot />
    </main>
    <Nav current={current} />
    <div id="demo-banner" style="display:none;position:fixed;top:8px;left:50%;transform:translateX(-50%);z-index:100;padding:4px 10px;background:var(--accent-cyan);color:#000;font-size:11px;font-weight:600;letter-spacing:0.05em;border-radius:999px;text-transform:uppercase;">Demo mode</div>
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
      // Show demo banner if ?demo=1 is in URL or was set this session.
      (() => {
        const KEY = 'flarestat:demo';
        if (new URLSearchParams(location.search).has('demo')) {
          sessionStorage.setItem(KEY, '1');
        }
        if (sessionStorage.getItem(KEY) === '1') {
          const b = document.getElementById('demo-banner');
          if (b) b.style.display = 'block';
        }
      })();
    </script>
  </body>
</html>
